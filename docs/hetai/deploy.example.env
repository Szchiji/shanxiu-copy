# 生产示例（请替换为新项目自己的值，不要复用任何源仓/现网密钥）
HETAI_MODE=production
HETAI_HOST=127.0.0.1
HETAI_PORT=8080
HETAI_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/hetai
HETAI_BOT_TOKEN=replace-with-new-bot-token
HETAI_WEBHOOK_SECRET=replace-with-long-random-string
HETAI_WEBHOOK_HOST=https://your-new-service.example
HETAI_WEBHOOK_PATH=/telegram/webhook
HETAI_WEBAPP_URL=https://your-new-service.example/app
HETAI_ADMIN_IDS=10001,10002
HETAI_SESSION_SECRET=replace-with-long-random-string
HETAI_RUN_SCHEDULER=true
# 本示例不会在启动时自动向 Telegram 注册 webhook，以免产生外部副作用。

# 出站传输：dry-run（默认，处理更新但不发送）或 live（显式出站）。不会自动注册 webhook。
HETAI_BOT_TRANSPORT=dry-run

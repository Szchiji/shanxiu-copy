# ── 必填 ──────────────────────────────────────────────
# 一个 Bot Token 同时驱动月影车姬和闪秀两套功能
BOT_TOKEN=123456:ABCDEF-your-bot-token

# 公网地址（必须 https，Telegram 只接受 https 的 webhook）
PUBLIC_URL=https://bot.example.com

# 数据库：两边共用同一个 Postgres（月影用到 JSONB/ARRAY，不能用 SQLite）
# 用 docker-compose 时主机名是 db；用外部数据库就改成完整连接串
DATABASE_URL=postgresql://postgres:changeme@db:5432/merged

# 管理员 Telegram 数字 ID，逗号分隔（月影的审核后台、闪秀的后台都用）
ADMIN_IDS=123456789

# ── 选填 ──────────────────────────────────────────────
# webhook 路径与密钥（密钥建议填，填了就要求 Telegram 带同一个 secret）
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=

# 月影的 Mini App 地址，留空会自动用 PUBLIC_URL/app
WEBAPP_URL=

# 给月影单独一个库时才填（不填=和上面共用）
# YY_DATABASE_URL=postgresql://postgres:changeme@db:5432/yueying

# Flash 后台的会话密钥（闪秀用），不填会用默认值并打警告
SECRET_KEY=change-this-to-a-random-string

# Redis（可选，闪秀的限流和月影的防刷会用它；不填走进程内存）
# REDIS_URL=redis://redis:6379/0

# ── docker-compose 用 ────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=merged
BOT_PORT=8080
